	measure 'Network Health Latest Month' =
			VAR AnchorDate = MAX('dim_date'[full_date])
			RETURN
				CALCULATE(
					[Network Health Score],
					REMOVEFILTERS('dim_date'),
					DATESBETWEEN(
						'dim_date'[full_date],
						DATE(YEAR(AnchorDate), MONTH(AnchorDate), 1),
						EOMONTH(AnchorDate, 0)
					)
				)
		formatString: 0.0
		displayFolder: 05 Network\Time Intelligence
		lineageTag: 45231e2b-0d9e-4430-9432-09135114b5c4

	measure 'Network Health Previous Month' =
			VAR AnchorDate = MAX('dim_date'[full_date])
			RETURN
				CALCULATE(
					[Network Health Score],
					REMOVEFILTERS('dim_date'),
					DATESBETWEEN(
						'dim_date'[full_date],
						EOMONTH(AnchorDate, -2) + 1,
						EOMONTH(AnchorDate, -1)
					)
				)
		formatString: 0.0
		displayFolder: 05 Network\Time Intelligence
		lineageTag: 446209af-fbc2-4744-908a-2da01b11e97e

	measure 'Network Health Change Points' = [Network Health Latest Month] - [Network Health Previous Month]
