	measure 'False Negative Customers' =
			CALCULATE(
				DISTINCTCOUNT('customer_churn_predictions'[customer_id]),
				'customer_churn_predictions'[actual_churn_label] = 1,
				'customer_churn_predictions'[predicted_churn_label] = 0
			)
		formatString: #,0
		displayFolder: 06 ML Performance
		lineageTag: b347e2d8-8412-44ab-8006-264deea450db

	measure 'False Negative Rate %' =
			VAR ActualChurnersScored =
				CALCULATE(
					DISTINCTCOUNT('customer_churn_predictions'[customer_id]),
					'customer_churn_predictions'[actual_churn_label] = 1
				)
			RETURN
				DIVIDE([False Negative Customers], ActualChurnersScored)
		formatString: 0.0%
		displayFolder: 06 ML Performance
		lineageTag: 00439083-35b5-4b71-90ef-b57aeb0bea45

	measure 'Top Churn Driver' =
			MAXX(
				TOPN(
					1,
					ALLSELECTED('ml_feature_importance'),
					'ml_feature_importance'[importance], DESC,
