				& " customers"
		displayFolder: 07 UX\Labels
		lineageTag: 8cce3dc9-1f67-4c0b-a054-e526f5044e7e

	measure 'Revenue Trend Label' =
			VAR ChangeValue = [Billed Revenue MoM %]
			RETURN
				IF(
					ISBLANK(ChangeValue),
					"No prior month",
					FORMAT(ChangeValue, "+0.0%;-0.0%;0.0%") & " vs prior month"
				)
		displayFolder: 07 UX\Labels
		lineageTag: 87f80586-0f91-41a6-bd32-9c049dae15d3

	measure 'Churn Risk Status' =
			SWITCH(
				TRUE(),
				[High Risk Active Rate %] >= 0.20, "Critical",
				[High Risk Active Rate %] >= 0.10, "Watch",
				"Stable"
			)
		displayFolder: 07 UX\Labels
		lineageTag: 99de35b1-520b-4afa-b0b6-cadc9e99b9e3

	measure 'Network Health Status' =
			SWITCH(
				TRUE(),
				[Network Health Latest Month] >= 80, "Healthy",
				[Network Health Latest Month] >= 65, "Watch",
				"Critical"
			)
		displayFolder: 07 UX\Labels
		lineageTag: 293953fa-4ded-4660-aed8-d2f28a178fcf

	measure 'Revenue Trend Color' = IF([Billed Revenue MoM %] >= 0, "#23C483", "#FF3B3B")
		displayFolder: 07 UX\Conditional Formatting
		lineageTag: 65eb9af3-dcd8-4bea-8430-010172d3d084

	measure 'Churn Risk Color' =
			SWITCH(
				TRUE(),
				[High Risk Active Rate %] >= 0.20, "#FF3B3B",
				[High Risk Active Rate %] >= 0.10, "#FFB020",
				"#23C483"
			)
		displayFolder: 07 UX\Conditional Formatting
		lineageTag: 5addf222-b751-4b93-b0ea-13469cfde20a

	measure 'Collection Rate Color' =
