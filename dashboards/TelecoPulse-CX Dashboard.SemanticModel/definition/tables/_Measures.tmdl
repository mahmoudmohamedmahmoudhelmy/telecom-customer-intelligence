	measure 'Selected Period Label' =
			VAR StartDate = MIN('dim_date'[full_date])
			VAR EndDate = MAX('dim_date'[full_date])
			RETURN
				FORMAT(StartDate, "dd MMM yyyy")
					& " — "
					& FORMAT(EndDate, "dd MMM yyyy")
		displayFolder: 07 UX\Labels
		lineageTag: 7521cf14-b0c7-4833-9ac4-031f699a3cd4

	measure 'Latest Visible Month Label' = FORMAT(MAX('dim_date'[full_date]), "MMM yyyy")
		displayFolder: 07 UX\Labels
		lineageTag: 1253ba9a-98e9-4c02-896d-dc7a5f13681a

	measure 'Executive Subtitle' =
			[Selected Period Label]
