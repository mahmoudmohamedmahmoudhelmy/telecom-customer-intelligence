	measure 'Latest Best Model' =
			MAXX(
				TOPN(
					1,
					ALLSELECTED('ml_model_performance'),
					'ml_model_performance'[evaluation_timestamp], DESC,
					'ml_model_performance'[roc_auc], DESC
				),
				'ml_model_performance'[model_name]
			)
		displayFolder: 06 ML Performance
		lineageTag: 42b46641-c68d-43c9-ba06-cb3abfd8adcd

	measure 'Latest Model Accuracy %' =
			MAXX(
