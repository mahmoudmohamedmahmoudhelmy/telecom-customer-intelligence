	column 'Prediction Outcome' =
			
			VAR ActualLabel =
			    'customer_churn_predictions'[actual_churn_label]
			VAR PredictedLabel =
			    'customer_churn_predictions'[predicted_churn_label]
			RETURN
			    SWITCH(
			        TRUE(),
			        ActualLabel = 1 && PredictedLabel = 1, "True Positive",
			        ActualLabel = 0 && PredictedLabel = 0, "True Negative",
			        ActualLabel = 0 && PredictedLabel = 1, "False Positive",
			        ActualLabel = 1 && PredictedLabel = 0, "False Negative",
			        "Unknown"
			    )
		lineageTag: 17150d4b-fc23-4c07-8b03-6ee19a54fad4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

